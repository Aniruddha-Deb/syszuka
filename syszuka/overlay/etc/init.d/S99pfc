#!/bin/sh

case "$1" in
    start)
        echo "Loading pfc module..."
        # no iTCO here, nor any NMI watchdogs
        echo 2 > /sys/bus/event_source/devices/cpu/rdpmc
        modprobe pfc
        ;;
    stop)
        echo "Unloading pfc module..."
        echo 0 > /sys/bus/event_source/devices/cpu/rdpmc
        rmmod pfc
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
